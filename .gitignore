# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
env/

# Data (raw/processed data can be large; keep repo light)
data/raw/*.csv
data/processed/*.csv
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep

# Models & results (regenerated by running the pipeline)
results/models/*.pkl
results/models/*.joblib
!results/models/.gitkeep
results/fraud_detection/*.csv

# Spark / Hadoop local runtime junk
derby.log
metastore_db/
spark-warehouse/
*.crc
_SUCCESS

# MongoDB local data dir (if run locally)
data/mongodb/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Test cache
.pytest_cache/

# Env files & secrets
.env
.env.*
*.pem
*.key
credentials*.json
secrets*

# Logs / temp
*.log
*.tmp
*.bak

# Out-of-sample test-set scores (regenerated by train_model.py)
results/fraud_detection/*.parquet
